{
  "name": "codex-web-community",
  "version": "1.0.0",
  "description": "Self-hosted browser access to your own Codex workspace",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "login": "node scripts/login.mjs",
    "doctor": "node scripts/doctor.mjs",
    "service": "node scripts/service.mjs",
    "password:reset": "node --env-file-if-exists=.env dist/server/server/account-cli.js password",
    "recovery:email": "node --env-file-if-exists=.env dist/server/server/account-cli.js email",
    "voice:setup": "node scripts/voice-setup.mjs",
    "dev": "tsx watch server/gateway.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run check && vite build --config vite.portal.config.ts && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:agent": "node scripts/agent-check.mjs",
    "pack:source": "node scripts/pack.mjs",
    "android:build": "node scripts/android-build.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/http-proxy": "^11.6.5",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/secure-session": "^8.0.0",
    "@fastify/static": "^10.1.8",
    "@inquirer/prompts": "^8.7.5",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "better-sqlite3": "13.0.3",
    "diff": "^8.0.2",
    "fastify": "^5.0.0",
    "http-proxy-3": "^2.0.2",
    "jsonl-parse-stringify": "^1.0.3",
    "nodemailer": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tree-kill": "^1.2.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/nodemailer": "^8.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^4.1.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.51.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
