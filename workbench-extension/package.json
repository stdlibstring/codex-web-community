{
  "name": "codex-web-layout",
  "publisher": "codex-web-community",
  "description": "Open the official Codex panel in a self-hosted web workbench",
  "license": "MIT",
  "files": ["extension.cjs", "LICENSE", "README.md"],
  "displayName": "Codex Web Layout",
  "version": "1.0.0",
  "engines": { "vscode": "^1.96.2" },
  "main": "./extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "extensionDependencies": ["openai.chatgpt"],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "contributes": {
    "configurationDefaults": {
      "chatgpt.openOnStartup": false,
      "claudeCode.preferredLocation": "sidebar",
      "workbench.colorTheme": "Dark Modern",
      "workbench.layoutControl.enabled": true,
      "workbench.layoutControl.type": "toggles",
      "workbench.activityBar.location": "hidden",
      "workbench.secondarySideBar.showLabels": true,
      "chat.disableAIFeatures": false,
      "workbench.secondarySideBar.defaultVisibility": "hidden"
    },
    "commands": [
      { "command": "codexWeb.focus", "title": "Codex: 显示完整面板" },
      { "command": "codexWeb.focusClaude", "title": "Claude Code: 显示完整面板" },
      { "command": "codexWeb.focusCopilot", "title": "Copilot: 显示完整面板" },
      { "command": "codexWeb.focusQoder", "title": "Qoder CN: 显示完整面板" }
    ]
  }
}
